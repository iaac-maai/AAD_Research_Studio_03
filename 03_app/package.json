{
  "name": "concrete-evidence-app",
  "private": true,
  "description": "Concrete Evidence: upload a photo of a column cage, get the rebar check, confirm or reject each fault",
  "scripts": {
    "cities": "node scripts/cities.mjs",
    "predev": "node scripts/cities.mjs",
    "db:local": "wrangler d1 execute concrete-evidence-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute concrete-evidence-db --remote --file=schema.sql",
    "dev": "wrangler pages dev --port 8788",
    "deploy": "wrangler pages deploy",
    "predeploy": "node scripts/cities.mjs"
  },
  "devDependencies": {
    "wrangler": "4.156.1"
  }
}
